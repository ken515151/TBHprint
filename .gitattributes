# Line endings matter for the shipped artefacts: a CRLF postinst or unit
# file breaks dpkg/systemd on the shop PC; Windows tooling wants CRLF.
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.path text eol=lf
*.timer text eol=lf
*.desktop text eol=lf
*.json text eol=lf
*.md text eol=lf
build/linux/** text eol=lf
packaging/** text eol=lf
*.ps1 text eol=crlf
*.iss text eol=crlf
*.ico binary
*.png binary
