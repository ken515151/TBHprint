[Unit]
Description=TBHprint - TechBenchHub print agent
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
User=tbhprint
# Primary group is "tbhprint" (not "lp") on purpose: this is the group
# that ends up owning /run/tbhprint/control.sock (mode 0660) because a
# freshly-created file/socket takes the creating process's PRIMARY group,
# and docs/DISTRIBUTION_DESIGN.md section 3 needs that group to be
# "tbhprint" so postinst can add the desktop user to exactly that group
# (not "lp", which would also hand them raw CUPS access). "lp" comes in
# as a supplementary group instead, purely so the daemon itself can talk
# to the local print spooler.
Group=tbhprint
SupplementaryGroups=lp
ExecStart=/opt/tbhprint/venv/bin/python -m tbhprint run
WorkingDirectory=/var/lib/tbhprint
Restart=always
RestartSec=3

RuntimeDirectory=tbhprint
RuntimeDirectoryMode=0750
StateDirectory=tbhprint
StateDirectoryMode=0750

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tbhprint /run/tbhprint /etc/tbhprint
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
